# Environment Configuration
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tododb

# JWT Settings
JWT_SECRET_KEY=your-super-secret-key-minimum-32-characters-long-for-production
JWT_ISSUER=TodoApp
JWT_AUDIENCE=TodoApp.API
JWT_EXPIRATION_MINUTES=60

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=todo-imports

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE_NAME=import-csv-queue
RABBITMQ_EXCHANGE_NAME=todo-exchange
RABBITMQ_ROUTING_KEY=todo.import
