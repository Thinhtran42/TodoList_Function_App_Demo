{
    "IsEncrypted": false,
    "Values": {
        "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
        "AzureWebJobsStorage": "DefaultEndpointsProtocol=https;AccountName=YOUR_STORAGE_ACCOUNT;AccountKey=YOUR_STORAGE_KEY;EndpointSuffix=core.windows.net",
        "ServiceBusQueueName": "import-csv-queue",
        "ServiceBusTopicName": "todo-notify-topic",
        "ServiceBusSubscriptionName": "todo-notification-subscription"
    },
    "ConnectionStrings": {
        "TodoDb": "Host=localhost;Port=5432;Database=todoapp;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD",
        "CosmosDb": "AccountEndpoint=https://YOUR_COSMOS_ACCOUNT.documents.azure.com:443/;AccountKey=YOUR_COSMOS_KEY",
        "AzureStorage": "DefaultEndpointsProtocol=https;AccountName=YOUR_STORAGE_ACCOUNT;AccountKey=YOUR_STORAGE_KEY;EndpointSuffix=core.windows.net",
        "ServiceBus": "Endpoint=sb://YOUR_SERVICEBUS_NAMESPACE.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=YOUR_SERVICEBUS_KEY"
    },
    "DatabaseProvider": "CosmosDB",
    "CosmosDB": {
        "DatabaseName": "TodoApp",
        "ContainerName": "Todos"
    },
    "JwtSettings": {
        "SecretKey": "YOUR_JWT_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG",
        "Issuer": "TodoApp",
        "Audience": "TodoApp",
        "ExpirationInMinutes": 60,
        "RefreshTokenExpirationInDays": 7
    }
}